{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wrike Access Roles Accounts API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.wrike.com/oauth2/authorize",
      "accessTokenUrl": "https://www.wrike.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.wrike.com/api/v4/accounts",
            "params": [
              {
                "name": "metadata",
                "value": "",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all accounts accessible to the current user."
        },
        {
          "info": {
            "name": "Update Account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.wrike.com/api/v4/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "metadata",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates account settings."
        }
      ]
    }
  ],
  "bundled": true
}