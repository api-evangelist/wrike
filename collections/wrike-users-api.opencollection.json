{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wrike Access Roles Users API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.wrike.com/oauth2/authorize",
      "accessTokenUrl": "https://www.wrike.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.wrike.com/api/v4/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user ID"
              }
            ]
          },
          "docs": "Returns information about a specific user."
        },
        {
          "info": {
            "name": "Update User",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.wrike.com/api/v4/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user ID"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "role",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates user profile information."
        }
      ]
    }
  ],
  "bundled": true
}