{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wrike Access Roles Workflows API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.wrike.com/oauth2/authorize",
      "accessTokenUrl": "https://www.wrike.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.wrike.com/api/v4/accounts/:accountId/workflows",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The account ID"
              }
            ]
          },
          "docs": "Returns all workflows in the specified account. Workflows define the status stages for tasks within the account."
        },
        {
          "info": {
            "name": "Create Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.wrike.com/api/v4/accounts/:accountId/workflows",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Creates a new workflow in the account."
        },
        {
          "info": {
            "name": "Update Workflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://www.wrike.com/api/v4/accounts/:accountId/workflows/:workflowId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "hidden",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates an existing workflow."
        }
      ]
    }
  ],
  "bundled": true
}